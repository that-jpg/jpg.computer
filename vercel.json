{
  "buildCommand": "uv run --with Pillow python3 generate.py && cd ub-app && npm ci && npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/ub/board/:slug", "destination": "/ub/board/index.html" },
    { "source": "/ub/board/:slug/", "destination": "/ub/board/index.html" }
  ],
  "redirects": [
    { "source": "/ub/projects", "destination": "/ub/boards/", "permanent": true },
    { "source": "/ub/projects/", "destination": "/ub/boards/", "permanent": true }
  ]
}
